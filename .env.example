# ===== 必須 =====
# OpenAI APIキー（サーバー側のみ。フロントエンド・ブラウザには絶対に渡さない）
OPENAI_API_KEY=
# このアプリへアクセスするための合言葉。長いランダム文字列にする（例: openssl rand -base64 32）。
# アプリの「設定」画面に一度入力する。OpenAIのキーとは別物。
APP_ACCESS_TOKEN=

# ===== モデル（コードへ直書きしないこと）=====
TRANSCRIBE_MODEL=gpt-transcribe
LLM_MODEL=gpt-6.1-sol
LLM_MODEL_LIGHT=gpt-6-luna
# 文字起こしの言語ヒント（ISO 639-1）
TRANSCRIBE_LANGUAGE=ja

# ===== プロバイダー =====
# openai | mock （mock は外部通信せずダミー結果を返す。開発・デモ用）
PROVIDER=openai

# ===== サーバー =====
PORT=8080
HOST=0.0.0.0
# 開発時のみ 1 にすると APP_ACCESS_TOKEN なしで起動できる
ALLOW_NO_AUTH=0

# ===== 上限・一時ファイル =====
MAX_UPLOAD_MB=200
MAX_DURATION_MIN=240
# 1チャンクの目標長（秒）。圧縮後25MB未満に十分収まる値
CHUNK_TARGET_SEC=600
CHUNK_CONCURRENCY=2
# 失敗ジョブの一時ファイルを再試行用に保持する最大分数。経過後に自動削除
JOB_TTL_MIN=30
# 簡易レート制限（1分あたりのリクエスト数/IP）
RATE_LIMIT_PER_MIN=120
